{
  "name": "lyra",
  "version": "0.1.7",
  "description": "a really cool web-proxy",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "build-folio": "bun scripts/build-folio.mjs",
    "build-rivet": "bun scripts/build-rivet.mjs",
    "build-proxy": "bun run build-folio && bun run build-rivet",
    "audit-build": "bun scripts/audit-build.mjs",
    "bench:backend": "bun scripts/backend-load.mjs",
    "dev:turn": "docker compose -f services/turn/compose.yml up",
    "start": "bun run build-proxy && NODE_ENV=production bun server/prod.mjs",
    "dev": "bun run build-proxy && NODE_ENV=development bun server/dev.mjs",
    "dev:web": "bun run build-proxy && DEV_AUTOSTART=0 NODE_ENV=development bun server/dev.mjs",
    "sync:prod": "bash scripts/sync-prod.sh",
    "notice": "bun scripts/notice.mjs",
    "chat": "bun scripts/chat.mjs",
    "build:chat-image-labels": "bun scripts/build-chat-image-labels.mjs",
    "build:ublock-state": "bun scripts/build-ublock-state.mjs",
    "check:chat-image": "bun scripts/check-chat-image.mjs",
    "check:chat-text": "bun scripts/check-chat-text.mjs",
    "setup:chat": "bun scripts/setup-chat.mjs",
    "test": "bun test --isolate scripts src",
    "test:sync-prod": "bun test --isolate scripts/sync-prod.test.mjs",
    "typecheck": "tsc --noEmit && bun run typecheck:rivet && bun run typecheck:folio",
    "typecheck:rivet": "tsc --noEmit --project packages/rivet/tsconfig.json && tsc --noEmit --project packages/rivet/tsconfig.worker.json",
    "typecheck:folio": "tsc --noEmit --project vendor/folio/tsconfig.json && tsc --noEmit --emitDeclarationOnly false --project vendor/folio/packages/core/tsconfig.json && bun run typecheck:folio:core-api && tsc --project vendor/folio/packages/controller/tsconfig.json && bun run typecheck:folio:controller-api && tsc --project vendor/folio/packages/utils/tsconfig.json",
    "typecheck:folio:core-api": "tsc --project vendor/folio/packages/core/tsconfig.types.json && bun vendor/folio/node_modules/tsc-alias/dist/bin/index.js --project vendor/folio/packages/core/tsconfig.types.json",
    "typecheck:folio:controller-api": "tsc --project vendor/folio/packages/controller/tsconfig.types.json",
    "lint": "eslint .",
    "build": "bun run build-proxy && vite build --config vite.config.js && bun run audit-build",
    "build:static": "bun run build-proxy && vite build --config vite.config.js --mode static && bun scripts/static-build.mjs",
    "sync:static": "bun scripts/static-sync.mjs",
    "static:local": "bun scripts/static-fixture.mjs --build",
    "postinstall": "bun scripts/patch-dependencies.mjs"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "latest",
    "@mercuryworkshop/epoxy-transport": "latest",
    "@mercuryworkshop/libcurl-transport": "latest",
    "@mercuryworkshop/proxy-transports": "1.0.2",
    "@preact/preset-vite": "^2.10.5",
    "@serenity-kit/opaque": "1.1.0",
    "express": "^5.0.0-beta.3",
    "hls.js": "^1.6.17",
    "jszip": "^3.10.1",
    "onnxruntime-node": "1.31.1",
    "preact": "^10.29.1",
    "vite": "^8.0.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.5.0",
    "javascript-obfuscator": "^5.0.1",
    "terser": "^5.46.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
